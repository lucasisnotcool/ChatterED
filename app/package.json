{
  "name": "chattered",
  "productName": "ChatterED",
  "version": "0.1.0",
  "private": true,
  "description": "ChatterED — explain a lecture concept to a group of AI study partners.",
  "author": "Lucas (NUS CS3249)",
  "license": "UNLICENSED",
  "main": "dist/main/index.js",
  "type": "commonjs",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-assets.mjs",
    "build:renderer": "vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit && svelte-check --tsconfig tsconfig.json --threshold error",
    "lint": "eslint src scripts",
    "test": "vitest run",
    "test:watch": "vitest",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "dist:mac": "npm run build && electron-builder --mac dmg",
    "install:local": "bash tools/install-local.sh install",
    "uninstall:local": "bash tools/install-local.sh uninstall-launchd",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "better-sqlite3": "^13.0.3",
    "pdfjs-dist": "^6.3.289"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.13.0",
    "better-sqlite3-node": "npm:better-sqlite3@^13.0.3",
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "eslint": "^9.39.5",
    "eslint-plugin-svelte": "^3.14.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.18.7",
    "marked": "^18.0.13",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
