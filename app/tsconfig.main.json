{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "sourceMap": true,
    // Comments cite research docs and people by name; they stay in the source, not the app.
    "removeComments": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": ["node"]
  },
  // src/preload is not here: it is bundled to one file by scripts/bundle-preload.mjs, because a
  // sandboxed preload cannot require its sibling modules. tsconfig.json still type-checks it.
  "include": ["src/core/**/*.ts", "src/main/**/*.ts", "src/room/**/*.ts", "src/shared/**/*.ts"],
  "exclude": ["src/**/*.test.ts", "src/**/*.test-support.ts"]
}
