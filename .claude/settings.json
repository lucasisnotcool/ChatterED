{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$CLAUDE_PROJECT_DIR\" && [ \"$(git config --get core.hooksPath)\" = .githooks ] || git config core.hooksPath .githooks",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-a2-private.sh",
            "timeout": 10,
            "statusMessage": "Checking the private-material boundary"
          }
        ]
      }
    ]
  }
}
