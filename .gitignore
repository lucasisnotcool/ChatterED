# ChatterED — .gitignore
# Committed on purpose (do NOT add here): docs/, Academia/, .claude/settings.json,
# .claude/hooks/. Those are project policy and source material, not local noise.

# --- Secrets and local-only config ---
.env
.env.*
!.env.example
*.local.*
.claude/settings.local.json
secrets/
*.pem
*.key
*.p12
credentials.json
service-account*.json

# --- Node ---
node_modules/
dist/
out/
app/models/
*.tsbuildinfo
build/Release
coverage/
.nyc_output
.npm
.eslintcache
.node_repl_history
*.tgz
.yarn-integrity
.pnp.*
.vite/
.next/
.turbo/

# --- Logs and runtime data ---
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
pids
*.pid
*.seed
*.pid.lock

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.Python
.venv/
venv/
env/
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# --- macOS ---
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# --- Editors ---
.idea/
*.swp
*.swo

# --- Research data: raw and processed transcripts/survey rows stay local ---
# CLAUDE.md: never commit raw transcripts or participant PII. The README, scripts and
# analysis in the same tree ARE committed; see docs/research/ai-use-transcripts/README.md.
docs/research/ai-use-transcripts/raw/
docs/research/ai-use-transcripts/processed/

# --- Scratch ---
tmp/
scratch/

# --- Interview data: local only, never committed ---
# CLAUDE.md: no participant PII, ever. The sheets under Academia/Interviews/ are raw interview
# records; what is committed is the de-identified analysis (P-codes, programme/year/gender only)
# in docs/research/interviews/.
Academia/Interviews/
Academia/valerie research/

# --- Lecturer's decks: used as the demo deck (#48), never committed ---
Academia/Sources/CS3249+Lecture+*.pdf

# --- Course and group-project material: local reference only ---
# Lecture and tutorial decks, class-recording transcripts and reading PDFs. Group-project
# material belongs in lucasisnotcool/cs3249-group (SCOPE.md zone 5), not in this repo.
Academia/group project/

# --- Assignment 2 deliverables never live in this repo (SCOPE.md) ---
# They are in ~/ChatterED-A2. These paths are reserved so a stray copy is never staged;
# .githooks/pre-commit refuses them even with git add -f.
a2-private/
docs/a2/
